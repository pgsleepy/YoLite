{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yolite",
  "version": "0.1.3",
  "identifier": "dev.yolite.client",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; media-src 'self' https: http://127.0.0.1:*; connect-src 'self' https: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "title": "Yolite",
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560,
        "decorations": true,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["deb", "rpm"],
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../node_modules/youtube-dl-exec/bin/yt-dlp": "bin/yt-dlp"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/pgsleepy/YoLite/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc4RTlBQzNDQkNCNTk5MDAKUldRQW1iVzhQS3pwZU5QQVloMEJ6bHVoRDdRcTNZNHA1UTJQVllqV1k1OVZocnVLRW9kWGZ3U1IK"
    }
  }
}
